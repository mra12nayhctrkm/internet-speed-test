{
  "name": "internet-speed-test",
  "version": "2.0.0",
  "description": "Console tool that measures download speed by making sequential HTTP requests to a URL",
  "keywords": [
    "speedtest",
    "bandwidth",
    "download",
    "cli"
  ],
  "type": "module",
  "bin": {
    "speedtest": "./bin/speedtest.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "start": "node bin/speedtest.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
